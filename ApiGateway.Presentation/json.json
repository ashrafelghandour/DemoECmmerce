{
    "Routes": [

        // JWT Authontication
        {
            "DownStreamPathTemplate": "/api/Authentication/{anyTheing}",
            "DownStreamScheme": "http",
            "DownStreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5000
                }
            ],
            "UpStreamPathTemplate": "/api/Authentication/{anyTheing}",
            "UpStreamHttpMethod": [ "Get", "Post" ],
            "RateLimitOptions": {
                "ClintWhitelist": [],
                "EnableRateLimiting": true,
                "Period": "60s",
                "Limit": 1,
                "PeriodTimespan": 10
            }

        },
        //Product Api
        //GET Method
        {
            "DownStreamPathTemplate": "/api/Products",
            "DownStreamScheme": "http",
            "DownStreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5001
                }
            ],
            "UpStreamPathTemplate": "/api/Products",
            "UpStreamHttpMethod": [ "Get" ],
            "RateLimitOptions": {
                "ClintWhitelist": [],
                "EnableRateLimiting": true,
                "Period": "60s",
                "Limit": 1,
                "PeriodTimespan": 10
            },
            "FileCacheOptions": {
                "TtlSeconds": 60,
                "Region": "default",
                "Header": "eCommerce-Caching-Control"
            }

        },

        // Get Product By Id
        {
            "DownStreamPathTemplate": "/api/Product/{id}",
            "DownStreamScheme": "http",
            "DownStreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5001
                }
            ],
            "UpStreamPathTemplate": "/api/Products/{id}",
            "UpStreamHttpMethod": [ "Get" ],
            "FileCacheOptions": {
                "TtlSeconds": 60,
                "Region": "default",
                "Header": "eCommerce-Caching-Control"
            }
        },

        // Product => Post ,put,Delete
        {
            "DownStreamPathTemplate": "/api/Product/{anyTheing}",
            "DownStreamScheme": "http",
            "DownStreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5001
                }
            ],
            "UpStreamPathTemplate": "/api/Products/{anyTheing}",
            "UpStreamHttpMethod": [ "POST", "PUT", "DELETE" ],
            "AuthenticationOptions": {
                "AuthenticationProviderKey": "Bearer",
                "AllowedScopes": []
            }
        },

        // Order
        {
            "DownStreamPathTemplate": "/api/Product/{id}",
            "DownStreamScheme": "http",
            "DownStreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5001
                }
            ],
            "UpStreamPathTemplate": "/api/Products/{id}",
            "UpStreamHttpMethod": [ "Get" ],
            "FileCacheOptions": {
                "TtlSeconds": 60,
                "Region": "default",
                "Header": "eCommerce-Caching-Control"
            }
        },

        // get Orders

        {
            "DownStreamPathTemplate": "/api/Orders",
            "DownStreamScheme": "http",
            "DownStreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5002
                }
            ],
            "UpStreamPathTemplate": "/api/Orders",
            "UpStreamHttpMethod": [ "Get" ],
            "RateLimitOptions": {
                "ClintWhitelist": [],
                "EnableRateLimiting": true,
                "Period": "60s",
                "Limit": 1,
                "PeriodTimespan": 10
            },
            "FileCacheOptions": {
                "TtlSeconds": 60,
                "Region": "default",
                "Header": "eCommerce-Caching-Control"
            }

        }

    ],



    "GlobalConfiguration": {
        "BaseUrl": "https://localhost:5003",
        "RateLimitOptions": {
            "QuotaExceededMessage": "You are overwhelming me wiht multiple requests. Relax small"
        }

    }
}